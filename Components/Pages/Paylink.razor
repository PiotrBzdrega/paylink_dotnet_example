@page "/paylink"
@using Clients
@using Services
@inject PaylinkService paylinkService
@inject IJSRuntime JS
@rendermode @(new InteractiveServerRenderMode(prerender: false)) // otherwise OnInitialized is called two times

<PageTitle>Paylink</PageTitle>

<p class="mb-3">
    <button class="btn btn-primary" @onclick="AddLog">
        Add log
    </button>
</p>

<div class="dropdown">
    <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        Actions
    </button>

    <ul class="dropdown-menu">
        <li>
            <button class="dropdown-item" @onclick="AddLog">
                getVersion()
            </button>
        </li>
        <li>
            <button class="dropdown-item" @onclick="AddLog">
                dispenseCoins(100)
            </button>
        </li>
        <li>
            <button class="dropdown-item" @onclick="AddLog">
                dispenseCoins(200)
            </button>
        </li>
        <li>
            <button class="dropdown-item" @onclick="AddLog">
                setMotor(true, 0)
            </button>
        </li>
        <li>
            <button class="dropdown-item" @onclick="AddLog">
                setMotor(false, 0)
            </button>
        </li>
        <li>
            <button class="dropdown-item" @onclick="AddLog">
                setMotor(true, 3000)
            </button>
        </li>
        <li>
            <button class="dropdown-item" @onclick="AddLog">
                setLED(1, true, 0)
            </button>
        </li>
        <li>
            <button class="dropdown-item" @onclick="AddLog">
                setLED(1, false, 0)
            </button>
        </li>
        <li>
            <button class="dropdown-item" @onclick="AddLog">
                setLED(1, true, 1000)
            </button>
        </li>
        <li>
            <button class="dropdown-item" @onclick="AddLog">
                levelOfCoins()
            </button>
        </li>
        <li>
            <button class="dropdown-item" @onclick="AddLog">
                currentCredit()
            </button>
        </li>
        <li>
            <button class="dropdown-item" @onclick="AddLog">
                getSensorsState()
            </button>
        </li>
        <li>
            <button class="dropdown-item" @onclick="AddLog">
                getButtonsState()
            </button>
        </li>
    </ul>
</div>

<div class="card">
    <div class="card-header">
        Logs
    </div>

    <div class="card-body p-2">
        <div @ref="logContainer" class="log-container overflow-auto"
             style="height: 300px; background:#111; color:#0f0; font-family:monospace;">

            @foreach (var log in Logs)
            {
                <div>@log</div>
            }
        </div>
    </div>
</div>

@code {

    private ElementReference logContainer;
    private bool shouldScroll;

    private List<string> Logs = new();

    public static string GenerateRandomString(int length)
    {
        const string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
        var random = new Random();
        return new string(Enumerable.Repeat(chars, length)
            .Select(s => s[random.Next(s.Length)]).ToArray());
    }

    private void AddLog()
    {
        var x = DateTime.Now.Second % 30;
        Logs.Add($"{DateTime.Now:HH:mm:ss} {GenerateRandomString(x)}");
        @* InvokeAsync(StateHasChanged); *@
        shouldScroll = true;
    }

    private void startPaylink()
    {
        paylinkService.Initialize();
    }

    private void stopPaylink()
    {
        paylinkService.Terminate();
    }

    protected override void OnInitialized()
    {
        AddLog();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldScroll)
        {
            shouldScroll = false;

            await JS.InvokeVoidAsync(
                "scrollToBottom",
                logContainer);
        }
    }
}